# OANDA v20 API credentials
OANDA_API_KEY=
OANDA_ENVIRONMENT=practice

# Block a repeat signal on the same symbol for this many minutes
SIGNAL_REENTRY_COOLDOWN_MIN=60

# Optional: Python executable for the MetaTrader 5 demo bridge
# MT5_PYTHON=python

# Optional: server port (default 5000)
# PORT=5000

# Optional: MetaTrader 5 auto-connect
# MT5_TERMINAL_PATH=
# Optional fallback only; the broker suffix is auto-detected on connect
# MT5_SYMBOL_SUFFIX=

# Gemini API key used for voice-trade announcements (falls back to browser speech when unset)
# GEMINI_API_KEY=

# Optional: post every signal + breakeven/TP/SL outcome to a Telegram channel.
# Bot must be added as admin of the channel. Chat id is @channelname or -100...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional: HTTP/SOCKS5 proxy for api.telegram.org if it is blocked on your network
# (e.g. http://127.0.0.1:7890 or socks5://127.0.0.1:1080)
# TELEGRAM_PROXY_URL=
# Optional: Cloudflare Worker relay (alternative to a proxy), see telegram-relay.worker.js
# TELEGRAM_API_BASE=
